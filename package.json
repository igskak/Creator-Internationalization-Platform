{
  "name": "regchef-content-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @rc/web dev",
    "build": "pnpm --filter @rc/web build",
    "db:generate": "pnpm --filter @rc/db generate",
    "db:migrate": "pnpm --filter @rc/db migrate",
    "db:seed": "pnpm --filter @rc/db seed",
    "jobs:dev": "pnpm --filter @rc/jobs dev",
    "jobs:hello": "pnpm --filter @rc/jobs hello",
    "check": "biome check . && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
