<body>
<div class="rc-slide" data-slide-id="fx-no-optionals" data-template="C" style="--rc-bg:#FFFFFF;--rc-surface:#FFFFFF;--rc-text:#111111;--rc-accent:#E1251B;--rc-positive:#111111;--rc-negative:#E1251B;--rc-font-display:&quot;Inter Tight&quot;, sans-serif;--rc-font-body:&quot;Inter Tight&quot;, sans-serif;--rc-safe-margin:72px;">
