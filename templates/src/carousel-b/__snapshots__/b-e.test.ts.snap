<div class="b-wrap has-photo">
<div class="slot display b-number figure" data-slot="number" data-fit data-fit-min="96" data-fit-max="150" style="font-size:150px;max-height:183px">180°</div>
<div class="slot display rc-kicker b-label" data-slot="label" data-fit data-fit-min="20" data-fit-max="24" style="font-size:24px;max-height:29px">Horno a 180 °C</div>

<div class="slot body b-body" data-slot="body" data-fit data-fit-min="32" data-fit-max="34" style="font-size:34px;max-height:402px">¿Cuánto tarda? ½ hora – quizá ¾. Añade “sal”, café y crème.</div>
</div>

<div class="rc-page" data-page>1/6</div>
</div>
<script>(function () {
  var STEP = 2;
