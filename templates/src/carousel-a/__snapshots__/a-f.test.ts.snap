"<!doctype html>
<html lang="en" data-template="F" data-template-version="2.0.0">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1080,initial-scale=1">
<style>
@font-face{font-family:"Inter Tight";font-style:normal;font-weight:100 900;font-display:block;src:url(data:font/woff2;base64,…) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:"Inter Tight";font-style:normal;font-weight:100 900;font-display:block;src:url(data:font/woff2;base64,…) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:1080px;height:1350px;background:#fff;overflow:hidden}
.rc-slide{--rc-muted:color-mix(in srgb,var(--rc-text) 60%,var(--rc-bg));position:relative;width:1080px;height:1350px;overflow:hidden;background:var(--rc-bg);color:var(--rc-text);font-family:var(--rc-font-body);-webkit-font-smoothing:antialiased;hyphens:none;-webkit-hyphens:none;font-kerning:normal;text-rendering:geometricPrecision}
.slot{flex:none;overflow:hidden;overflow-wrap:break-word;word-break:normal;position:relative;z-index:1}
.slot.display{font-family:var(--rc-font-display);line-height:1.02;padding-block:.1em;text-wrap:balance;font-weight:800;text-transform:uppercase;letter-spacing:-.02em}
.slot.body{font-family:var(--rc-font-body);line-height:1.3;padding-block:.06em;font-weight:300}
.slot em{font-style:normal}
.slot.body em{font-weight:700}
.slot.display em{color:var(--rc-accent)}
.slot.rc-kicker{font-family:var(--rc-font-body);font-weight:600;text-transform:uppercase;letter-spacing:.14em;text-wrap:wrap}
.img{display:block;object-fit:cover}
.img.cutout{position:absolute;left:0;top:0;width:1080px;height:1350px;z-index:0;mix-blend-mode:multiply}
.img-missing{background:repeating-linear-gradient(45deg,#ececec,#ececec 12px,#f6f6f6 12px,#f6f6f6 24px)}
.rc-logo{position:absolute;display:flex;align-items:center;z-index:2}
.rc-logo img{display:block;height:100%;width:auto}
.rc-handle,.rc-page{position:absolute;bottom:44px;z-index:2;font-family:var(--rc-font-body);font-size:22px;line-height:1;letter-spacing:.02em;font-weight:400}
.rc-handle{left:var(--rc-safe-margin);color:var(--rc-text)}
.rc-page{right:var(--rc-safe-margin);color:var(--rc-muted)}
.f-wrap{position:absolute;left:var(--rc-safe-margin);top:112px;bottom:120px;width:620px;display:flex;flex-direction:column;gap:32px}
.f-offer{color:var(--rc-accent)}
.f-body{width:470px}
.f-keyword{color:var(--rc-accent);letter-spacing:.02em}
.f-photo{transform:translate(180px,320px)}
</style>
</head>
<body>
<div class="rc-slide" data-slide-id="fx-no-optionals" data-template="F" style="--rc-bg:#FFFFFF;--rc-surface:#FFFFFF;--rc-text:#111111;--rc-accent:#E1251B;--rc-positive:#111111;--rc-negative:#E1251B;--rc-font-display:&quot;Inter Tight&quot;, sans-serif;--rc-font-body:&quot;Inter Tight&quot;, sans-serif;--rc-safe-margin:72px;">
<img class="img cutout f-photo" data-image="product" alt="" src="data:image/webp;base64,UklGRg==">
<div class="f-wrap">

<div class="slot display f-headline" data-slot="headline" data-fit data-fit-min="56" data-fit-max="100" style="font-size:100px;max-height:428px">Guárdalo</div>
<div class="slot body f-body" data-slot="body" data-fit data-fit-min="32" data-fit-max="34" style="font-size:34px;max-height:269px">Te servirá la próxima vez.</div>

</div>

<div class="rc-page" data-page>1/6</div>
</div>
<script>(function () {
  var STEP = 2;
  function overflows(el) {
    return el.scrollHeight > el.clientHeight + 1 || el.scrollWidth > el.clientWidth + 1;
  }
  function fit() {
    var nodes = document.querySelectorAll("[data-fit]");
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      var max = Number(el.getAttribute("data-fit-max"));
      var min = Number(el.getAttribute("data-fit-min"));
      var size = max;
      el.style.fontSize = size + "px";
      while (size > min && overflows(el)) {
        size = Math.max(min, size - STEP);
        el.style.fontSize = size + "px";
      }
      if (overflows(el)) el.setAttribute("data-overflow", "true");
      el.setAttribute("data-font-px", String(size));
    }
    document.documentElement.setAttribute("data-fit-done", "true");
  }
  window.__rcFit = fit;
  var ready = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
  ready.then(fit, fit);
})();</script>
</body>
</html>
"
`;

