# Server environment, validated by @rc/lib/env (loadServerEnv). Copy to .env and fill in.
# Empty values count as unset. Use dev keys only; production values live in Vercel / Trigger.dev.
# Plan: docs/plan/12-security-observability.md §12.2.

# --- Environment -------------------------------------------------------------------------
# development | test | staging | production. Production refuses JOBS_MODE=inline,
# AI_PROVIDER=fake, STORAGE_PROVIDER=memory and any E2E_TEST_AUTH_SECRET.
APP_ENV=development

# --- Mode flags ----------------------------------------------------------------------------
# inline (run jobs in-process, dev/tests) | trigger (Trigger.dev). Default: inline.
JOBS_MODE=inline
# live (Anthropic + OpenAI) | fake (deterministic fakes, no keys needed). Default: live.
AI_PROVIDER=fake
# r2 | memory (in-process, tests only). Default: r2.
STORAGE_PROVIDER=memory
# off | dry_run_only | live. Default: off. Dev: dry_run_only at most (live only for test accounts).
INSTAGRAM_PUBLISH_MODE=off

# --- Database (Supabase Postgres) --------------------------------------------------------------
# Required. Transaction pooler (port 6543) for web and jobs; prepared statements are turned off
# for it automatically. Locally any Postgres URL works. See docs/runbooks/supabase.md.
# postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=
# Optional, for `pnpm db:migrate`: session pooler (port 5432, IPv4) or direct connection.
# postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL_DIRECT=

# --- Seed (`pnpm db:seed` only) -------------------------------------------------------------
# Comma-separated emails that get an active owner account. Existing users are never changed.
SEED_OWNER_EMAILS=

# --- Supabase Auth -------------------------------------------------------------------------------
# Required.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Admin scripts only (invite users). Never set in the web runtime.
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage: Cloudflare R2 (required when STORAGE_PROVIDER=r2) -----------------------------
R2_ACCOUNT_ID=
# API token scoped to this environment's bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# `eu` for EU-jurisdiction buckets (recommended; see docs/runbooks/r2-setup.md).
R2_JURISDICTION=eu
# Optional https base URL for renders if Meta rejects presigned URLs (plan V-14).
RENDERS_PUBLIC_BASE_URL=

# --- AI providers (required when AI_PROVIDER=live) ---------------------------------------------
ANTHROPIC_API_KEY=
# Embeddings and the first image adapter.
OPENAI_API_KEY=

# --- Jobs: Trigger.dev (required when JOBS_MODE=trigger) -------------------------------------
# Dev key from the Trigger.dev dashboard (API keys → dev). Required when JOBS_MODE=trigger.
TRIGGER_SECRET_KEY=
# Project ref (proj_…) for `pnpm jobs:dev`; not secret. Read by jobs/trigger.config.ts only.
TRIGGER_PROJECT_REF=
# TRIGGER_ACCESS_TOKEN is for CI deploys only (GitHub secret), not for the app runtime.

# --- Instagram / Meta (required when INSTAGRAM_PUBLISH_MODE is dry_run_only or live) ---------
IG_APP_ID=
IG_APP_SECRET=
# OAuth callback, e.g. https://<host>/api/instagram/oauth/callback
IG_REDIRECT_URI=
# Graph API version, e.g. v24.0. Pin the current one after verification V-04 (M5-00).
META_GRAPH_API_VERSION=
# Optional. Default https://graph.instagram.com; E2E points it at the mock Graph API.
INSTAGRAM_GRAPH_BASE_URL=
# Optional. Comma-separated Instagram account ids allowed to publish in this environment.
INSTAGRAM_ACCOUNT_ALLOWLIST=

# --- Security (required) ---------------------------------------------------------------------
# Key ring for Instagram token encryption: v1:<base64 of 32 bytes>[,v2:…]. Keep old keys until
# tokens are re-encrypted. New key: echo "v1:$(openssl rand -base64 32)"
TOKEN_ENCRYPTION_KEYS=
# Key id used for new ciphertexts, e.g. v1. Must exist in TOKEN_ENCRYPTION_KEYS.
TOKEN_ENCRYPTION_ACTIVE_KEY=
# HMAC secret for OAuth state, at least 32 characters: openssl rand -base64 48
OAUTH_STATE_SECRET=

# --- Observability ------------------------------------------------------------------------------
# Optional. Sentry DSN for web and jobs.
SENTRY_DSN=
# fatal | error | warn | info | debug | trace. Default: info.
LOG_LEVEL=info
# SENTRY_AUTH_TOKEN is for CI source map uploads only (GitHub secret), not for the app runtime.

# --- Tests ---------------------------------------------------------------------------------------
# Enables the E2E test-login route. At least 32 characters. Never set in production.
E2E_TEST_AUTH_SECRET=
